rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'adn.semicon@gmail.com';
    }

    function isApprovedEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt', 'photoURL'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.keys().hasAny(['photoURL'])
          || (
            request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('^https://([a-zA-Z0-9-]+\\.)*googleusercontent\\.com/.*$')
          )
        );

      allow update: if (
          isAdmin()
          && request.resource.data.updatedAt == request.time
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'updatedAt'
              ])
              && request.resource.data.status in ['approved', 'rejected']
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'leaveBalances', 'updatedAt'
              ])
              && request.resource.data.leaveBalances is map
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName', 'updatedAt'
              ])
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName', 'jobTitle', 'department', 'phone', 'updatedAt'
              ])
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 120
              && request.resource.data.jobTitle is string
              && request.resource.data.jobTitle.size() <= 120
              && request.resource.data.department is string
              && request.resource.data.department.size() <= 120
              && request.resource.data.phone is string
              && request.resource.data.phone.size() <= 50
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName', 'nickname', 'officialEmail', 'reportingManagerId', 'githubId', 'trackRecords', 'phone', 'updatedAt'
              ])
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 120
              && request.resource.data.nickname is string
              && request.resource.data.nickname.size() <= 120
              && request.resource.data.officialEmail is string
              && request.resource.data.officialEmail.size() <= 254
              && (
                request.resource.data.officialEmail == ''
                || request.resource.data.officialEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
              )
              && request.resource.data.reportingManagerId is string
              && request.resource.data.reportingManagerId.size() <= 128
              && (
                request.resource.data.reportingManagerId == ''
                || (
                  request.resource.data.reportingManagerId != userId
                  && exists(/databases/$(database)/documents/users/$(request.resource.data.reportingManagerId))
                  && get(/databases/$(database)/documents/users/$(request.resource.data.reportingManagerId)).data.status == 'approved'
                )
              )
              && request.resource.data.githubId is string
              && request.resource.data.githubId.size() <= 39
              && request.resource.data.trackRecords is list
              && request.resource.data.phone is string
              && request.resource.data.phone.size() <= 50
            )
          )
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'photoURL', 'updatedAt'
          ])
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 2048
          && request.resource.data.photoURL.matches('^https://([a-zA-Z0-9-]+\\.)*googleusercontent\\.com/.*$')
        );

      allow delete: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow get, list: if isAdmin()
        || (isApprovedEmployee() && resource.data.employeeId == request.auth.uid);

      allow create: if isApprovedEmployee()
        && request.resource.data.keys().hasAll([
          'employeeId', 'employeeEmail', 'employeeName', 'type',
          'startDate', 'endDate', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeEmail', 'employeeName', 'type',
          'startDate', 'endDate', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.employeeName is string
        && request.resource.data.type in ['Annual leave', 'Sick leave']
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.token.email;

      allow delete: if isAdmin();
    }

    match /leaveNotifications/{notificationId} {
      allow create: if request.resource.data.keys().hasAll([
          'requestId', 'employeeId', 'event', 'employeeEmail', 'employeeName',
          'type', 'startDate', 'endDate', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'employeeId', 'event', 'employeeEmail', 'employeeName',
          'type', 'startDate', 'endDate', 'reason', 'createdAt'
        ])
        && request.resource.data.requestId is string
        && request.resource.data.employeeId is string
        && request.resource.data.employeeEmail is string
        && request.resource.data.employeeName is string
        && request.resource.data.type in ['Annual leave', 'Sick leave']
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.employeeId == request.resource.data.employeeId
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.employeeEmail == request.resource.data.employeeEmail
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.employeeName == request.resource.data.employeeName
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.type == request.resource.data.type
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.startDate == request.resource.data.startDate
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.endDate == request.resource.data.endDate
        && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.reason == request.resource.data.reason
        && (
          (
            request.resource.data.event == 'submitted'
            && notificationId == request.resource.data.requestId + '_submitted'
            && isApprovedEmployee()
            && request.resource.data.employeeId == request.auth.uid
            && !exists(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId))
            && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.status == 'pending'
          )
          || (
            request.resource.data.event in ['approved', 'rejected']
            && notificationId == request.resource.data.requestId + '_' + request.resource.data.event
            && isAdmin()
            && exists(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId))
            && get(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/leaveRequests/$(request.resource.data.requestId)).data.status == request.resource.data.event
          )
        );

      allow read, update, delete: if false;
    }

    match /attendance/{recordId} {
      allow get, list: if isAdmin()
        || (isApprovedEmployee() && resource.data.employeeId == request.auth.uid);

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'employeeId', 'employeeName', 'date', 'status',
          'note', 'recordedAt', 'recordedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'date', 'status',
          'note', 'recordedAt', 'recordedBy'
        ])
        && request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status in [
          'present', 'late', 'absent', 'leave', 'annual-leave', 'sick-leave'
        ]
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 240
        && request.resource.data.recordedAt == request.time
        && request.resource.data.recordedBy == request.auth.token.email
        && recordId == request.resource.data.employeeId + '_' + request.resource.data.date
        && exists(/databases/$(database)/documents/users/$(request.resource.data.employeeId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.employeeId)).data.status == 'approved'
        && (
          !exists(/databases/$(database)/documents/attendance/$(recordId))
          || (
            request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.date == resource.data.date
          )
        );

      allow delete: if isAdmin();
    }

    // The control document opens the next reporting day only after the email succeeds.
    // Before the first email, submissions are open until 11:30 PM Asia/Dhaka.
    function dailyCollectionOpen() {
      let controlPath = /databases/$(database)/documents/system/dailyUpdates;
      return exists(controlPath)
        ? get(controlPath).data.accepting == true
          && request.time < get(controlPath).data.acceptingUntil
        : dailyWindowOpenBeforeFirstSend();
    }

    function dailyWindowOpenBeforeFirstSend() {
      let msOfDay = request.time.toMillis() % 86400000;
      return msOfDay < 63000000 || msOfDay >= 64800000;
    }

    function dailyCollectionDateMatches() {
      let controlPath = /databases/$(database)/documents/system/dailyUpdates;
      return !exists(controlPath)
        || request.resource.data.date == get(controlPath).data.collectingDate;
    }

    function validBullets(items) {
      return items is list && items.size() <= 30;
    }

    function validDailyUpdate(uid) {
      return request.resource.data.keys().hasOnly([
          'employeeId', 'employeeEmail', 'employeeName', 'date',
          'todaysTasks', 'suddenTasks', 'blockers', 'plans', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeId', 'employeeEmail', 'employeeName', 'date',
          'todaysTasks', 'suddenTasks', 'blockers', 'plans', 'updatedAt'
        ])
        && request.resource.data.employeeId == uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.employeeName is string
        && request.resource.data.employeeName.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && validBullets(request.resource.data.todaysTasks)
        && validBullets(request.resource.data.suddenTasks)
        && validBullets(request.resource.data.blockers)
        && validBullets(request.resource.data.plans)
        && request.resource.data.updatedAt == request.time;
    }

    // One document per employee for the current day; the 11:30 PM job emails and deletes them.
    match /dailyUpdates/{uid} {
      allow get, list: if isAdmin()
        || (isApprovedEmployee() && request.auth.uid == uid);

      allow create, update: if isApprovedEmployee()
        && request.auth.uid == uid
        && dailyCollectionOpen()
        && dailyCollectionDateMatches()
        && validDailyUpdate(uid);

      allow delete: if isAdmin()
        || (isApprovedEmployee() && request.auth.uid == uid && dailyCollectionOpen());
    }

    match /system/{documentId} {
      allow get: if documentId == 'dailyUpdates' && (isAdmin() || isApprovedEmployee());
    }

    match /concerns/{concernId} {
      allow get, list: if isAdmin()
        || (isApprovedEmployee() && resource.data.employeeId == request.auth.uid);

      allow create: if isApprovedEmployee()
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeEmail', 'employeeName', 'subject', 'body',
          'status', 'lastMessageBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeId', 'employeeEmail', 'employeeName', 'subject', 'body',
          'status', 'lastMessageBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.employeeName is string
        && request.resource.data.employeeName.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.lastMessageBy == 'employee'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lastMessageBy', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            isAdmin()
            && request.resource.data.status in ['open', 'resolved']
            && request.resource.data.lastMessageBy == 'admin'
          )
          || (
            isApprovedEmployee()
            && resource.data.employeeId == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.lastMessageBy == 'employee'
          )
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow delete: if isAdmin();

        allow get, list: if isAdmin()
          || (
            isApprovedEmployee()
            && get(/databases/$(database)/documents/concerns/$(concernId)).data.employeeId == request.auth.uid
          );

        allow create: if request.resource.data.keys().hasOnly([
            'authorId', 'authorRole', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'authorId', 'authorRole', 'text', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            (isAdmin() && request.resource.data.authorRole == 'admin')
            || (
              isApprovedEmployee()
              && request.resource.data.authorRole == 'employee'
              && get(/databases/$(database)/documents/concerns/$(concernId)).data.employeeId == request.auth.uid
            )
          );
      }
    }

    match /notices/{noticeId} {
      allow get, list: if isAdmin() || isApprovedEmployee();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'title', 'body', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'createdAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;

      allow delete: if isAdmin();
    }
  }
}

{
  "name": "ems-worker-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for Employee Daily Update System",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute ems-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute ems-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.103.1"
  }
}
